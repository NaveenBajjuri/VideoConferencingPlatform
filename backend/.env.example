# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# Server
PORT=8000
NODE_ENV=development

# MongoDB
# Rotate any credentials that were previously hardcoded/committed in source control.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/zoom-clone

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional) - enables horizontal scaling of Socket.IO across instances
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# TURN server (optional but recommended for production - coturn or a managed provider)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Mediasoup SFU (media server). Calls are relayed through this server instead
# of being direct browser-to-browser mesh connections.
# MEDIASOUP_ANNOUNCED_IP is the important one to set correctly in production:
# it's the IP mediasoup puts into ICE candidates for clients to connect to.
#   - Local dev: leave as 127.0.0.1
#   - Docker/cloud/behind NAT: set to your server's public IP, or the
#     container host's IP if you're doing port-forwarding
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
# Blank = one worker per CPU core (recommended). Set a number to override.
MEDIASOUP_NUM_WORKERS=
MEDIASOUP_WORKER_LOG_LEVEL=warn

# Email (optional) - used for meeting invite emails via nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zoom Clone <no-reply@example.com>"

# Logging
LOG_LEVEL=info
