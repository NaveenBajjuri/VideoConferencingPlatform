{
  "name": "backend",
  "version": "2.0.0",
  "description": "Zoom Clone backend - REST API + Socket.IO signaling server",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "prod": "pm2 start dist/app.js --name zoom-backend",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "lint": "eslint src --ext .ts"
  },
  "author": "apnacollege",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "http-status": "^1.7.3",
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.26.0",
    "mongoose": "^8.0.3",
    "nodemailer": "^6.9.13",
    "nodemon": "^3.0.2",
    "socket.io": "^4.7.3",
    "winston": "^3.13.0"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "puppeteer-core": "^25.10.0",
    "socket.io-client": "^4.7.3",
    "supertest": "^6.3.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
