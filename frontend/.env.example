# Copy this file to .env (and .env.production for prod builds) and adjust.

# Backend REST + Socket.IO server URL
REACT_APP_SERVER_URL=http://localhost:8000

# Optional TURN server, used as a client-side ICE relay fallback for
# participants behind restrictive NATs/firewalls that can't reach the
# mediasoup SFU server directly. Not needed for most deployments - mediasoup's
# server-side transports are ICE-Lite and don't require STUN/TURN on their
# own end, this only helps the small fraction of clients that can't punch
# through their local NAT.
REACT_APP_TURN_URL=
REACT_APP_TURN_USERNAME=
REACT_APP_TURN_CREDENTIAL=
